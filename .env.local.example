# 환경변수 설정 가이드

# 이 파일을 복사해서 .env.local 로 저장 후 값을 채우세요
# cp .env.local.example .env.local

# ── Neon PostgreSQL ─────────────────────────────────────────
# Neon 콘솔 → 프로젝트 → Connection string 에서 복사
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# 풀링 연결이 필요한 경우 (서버리스 환경)
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require

# ── 앱 설정 ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 인증 (자체 구현) ─────────────────────────────────────────
# 세션 암호화 키 (32자 이상 랜덤 문자열)
AUTH_SECRET=your-secret-key-here

# ── 기타 ────────────────────────────────────────────────────
# NODE_ENV는 Next.js가 자동 설정
